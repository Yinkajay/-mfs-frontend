{
  "name": "mfsservices",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy": "npm run build && node scripts/deploy-ftps.mjs",
    "deploy:check": "node scripts/deploy-ftps.mjs --check",
    "test:deploy": "node --test scripts/deploy-ftps.test.mjs",
    "test:auth": "node --test scripts/auth.test.mjs",
    "test:vehicles": "node --test scripts/vehicles.test.mjs",
    "test:auth:browser": "playwright test tests/auth.spec.ts",
    "test:auth:live": "playwright test tests/auth-live.spec.ts",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint",
    "optimize:hero": "node scripts/optimize-hero-images.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "basic-ftp": "6.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
