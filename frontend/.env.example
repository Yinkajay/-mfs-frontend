# Public, build-time URL. Include /v1, without a trailing slash.
# Use localhost for BOTH apps locally (do not mix it with 127.0.0.1).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1

# For a public HTTPS deployment, set the real same-site API URL before building.
# Example only: NEXT_PUBLIC_API_BASE_URL=https://api.mfsservicesng.com/v1
# Never put database credentials or session secrets in frontend env files.
